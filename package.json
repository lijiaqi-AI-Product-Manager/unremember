{
  "name": "unremember",
  "version": "1.0.3",
  "description": "Make a local coding agent truly forget something: remove it from the session, its echoes and its off-session copies (memory, prompt history), then prove it with leak probes.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijiaqimun-coder/unremember.git"
  },
  "homepage": "https://github.com/lijiaqimun-coder/unremember#readme",
  "bugs": "https://github.com/lijiaqimun-coder/unremember/issues",
  "bin": {
    "unremember": "dist/guard.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "assets",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "claude-code",
    "deepseek-harness",
    "dsh",
    "agent",
    "context",
    "privacy",
    "forget",
    "transcript"
  ],
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  }
}
